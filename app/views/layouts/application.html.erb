<!DOCTYPE html>
<html>
  <head>
    <title>ShiftTracker Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar">
      <%= link_to "ShiftTracker Pro", root_path, class: "navbar-brand" %>
      
      <div>
        <% if user_signed_in? %>
          <span style="margin-right: 15px; color: var(--text-light);">
            <%= current_user.username || current_user.email.split('@').first %>
          </span>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn btn-outline", style: "display: inline-block;" %>
        <% end %>
      </div>
    </nav>

    <main class="container">
      <% if notice %>
        <div style="background: #d1fae5; color: #065f46; padding: 10px; border-radius: 5px; margin-bottom: 20px;"><%= notice %></div>
      <% end %>
      
      <%= yield %>
    </main>
  </body>
</html>