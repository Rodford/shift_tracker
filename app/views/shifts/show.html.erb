<%= link_to "← Back to Dashboard", root_path, style: "text-decoration: none; color: var(--primary); display: inline-block; margin-bottom: 20px;" %>

<div class="card">
  <h1 style="margin-top: 0; margin-bottom: 5px;"><%= @shift.date.to_fs(:long_ordinal) %> - <%= @shift.shift_type %></h1>
  <p style="color: var(--text-light); margin-top: 0;">Logged by: <%= @shift.user.username || @shift.user.email.split('@').first %></p>

  <% if @shift.notes.present? %>
    <div style="background-color: var(--bg); padding: 15px; border-radius: 5px; margin-top: 15px; border: 1px solid var(--border);">
      <strong style="display: block; margin-bottom: 5px;">Notes:</strong> 
      <%= @shift.notes %>
    </div>
  <% end %>
</div>

<h2 style="margin-top: 30px;">Go-By Tasks</h2>

<div class="card" style="padding: 0;">
  <ul style="list-style-type: none; padding: 0; margin: 0;">
    <% @shift.tasks.each do |task| %>
      <% if task.persisted? %>
        <li style="padding: 15px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 15px;">
          
          <%= link_to toggle_shift_task_path(@shift, task), data: { turbo_method: :patch }, style: "text-decoration: none; font-size: 1.5em; cursor: pointer; color: var(--primary); user-select: none;" do %>
            <%= task.is_completed ? "☑" : "☐" %>
          <% end %>
          
          <span style="<%= 'text-decoration: line-through; color: var(--text-light);' if task.is_completed %>; flex-grow: 1;">
            <%= task.description %>
          </span>
          
          <% if task.is_completed && task.completed_at %>
            <small style="color: var(--text-light);">
              <%= task.completed_at.strftime("%I:%M %p") %>
            </small>
          <% end %>

          <div style="margin-left: 10px;">
            <%= link_to "Delete", shift_task_path(@shift, task), data: { turbo_method: :delete, turbo_confirm: "Delete this task?" }, style: "color: var(--danger); text-decoration: none; font-size: 0.85em;" %>
          </div>
        </li>
      <% end %>
    <% end %>
  </ul>
  
  <div style="padding: 15px; background: var(--bg); border-radius: 0 0 8px 8px;">
    <%= form_with model: [@shift, @task], style: "display: flex; gap: 10px;" do |form| %>
      <%= form.text_field :description, placeholder: "e.g., Clean the espresso machine", style: "margin-top: 0; flex-grow: 1;" %>
      <%= form.submit "Add Task", class: "btn" %>
    <% end %>
  </div>
</div>