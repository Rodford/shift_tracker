<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
  <h1 style="margin: 0;">Recent Shifts</h1>
  <%= link_to "Log a New Shift", new_shift_path, class: "btn" %>
</div>

<% if @shifts.any? %>
  <% @shifts.each do |shift| %>
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        
        <div>
          <h3 style="margin: 0 0 5px 0;">
            <%= link_to shift.date.to_fs(:long_ordinal), shift_path(shift), style: "text-decoration: none; color: var(--primary);" %> 
            <span style="color: var(--text-light); font-size: 0.8em; font-weight: normal;">(<%= shift.shift_type %>)</span>
          </h3>
          <p style="margin: 0; color: var(--text-light); font-size: 0.9em;">
            Logged by: <%= shift.user.username || shift.user.email.split('@').first %>
          </p>
          
          <% if shift.notes.present? %>
            <p style="margin: 10px 0 0 0; font-size: 0.95em;">
              <strong>Notes:</strong> <%= shift.notes %>
            </p>
          <% end %>
        </div>

        <div>
          <%= link_to "Delete", shift_path(shift), data: { turbo_method: :delete, turbo_confirm: "Delete this shift?" }, class: "btn btn-danger" %>
        </div>

      </div>
    </div>
  <% end %>
<% else %>
  <div class="card" style="text-align: center; color: var(--text-light);">
    <p>No shifts logged yet! Click the button above to get started.</p>
  </div>
<% end %>